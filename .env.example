# Server
PORT=3000
NODE_ENV=development

# JWT secrets
# Replace these with long random strings before deploying.
JWT_SECRET=please-change-this-access-secret
JWT_REFRESH_SECRET=please-change-this-refresh-secret

# Railway volume path for SQLite persistence.
# Leave empty for local development; Railway can provide this when a volume is configured.
# RAILWAY_VOLUME_DIR=/data
